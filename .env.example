# -----------------------------------------------------------------------------
# WRAITH - environment template
# -----------------------------------------------------------------------------
# Copy this file to ".env" and paste your own GitHub token in below:
#
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# The token is ONLY used to raise the GitHub code-search rate limit
# (5,000 req/hr authenticated vs 60 req/hr anonymous). It needs NO scopes:
#
#   github.com/settings/tokens  ->  Generate new token (classic)
#   ->  leave every scope unchecked  ->  Generate
#
# Never commit your real ".env" file. It is already listed in .gitignore,
# but double-check before pushing anything public.
# -----------------------------------------------------------------------------

GITHUB_TOKEN=ghp_paste_your_own_token_here
